/**
 * 打开全屏相机，持续返回裁剪人脸、静默活体分数和相机原图。
 */
@UTSJS.keepAlive
export function captureFaceByCamera(
    performanceMode: number,
    needLivenessCheck: boolean,
    cameraId: number,
    linearZoom: number,
    rotationDegrees: number,
    callback: (result: CaptureFaceResult) => void,
    errorCallback: (error: CaptureFaceError) => void
): void {
    CaptureFaceResultManager.setResultCallback((
        croppedBase64: string,
        silentScore: number,
        originBase64: string
    ) => {
        callback({
            croppedBase64: croppedBase64,
            silentScore: silentScore,
            originBase64: originBase64
        } as CaptureFaceResult)
    })
    CaptureFaceResultManager.setErrorCallback((code: string, message: string) => {
        errorCallback({ code: code, message: message } as CaptureFaceError)
    })

    UTSAndroid.getUniActivity()!.runOnUiThread(() => {
        const context = UTSAndroid.getUniActivity() as Activity
        FaceSDKConfig.init(context)
        const intent = new Intent(context, CaptureFaceActivity().javaClass)
        intent.putExtra("CAPTURE_FACE_PERFORMANCE_MODE", performanceMode.toInt())
        intent.putExtra("CAPTURE_FACE_NEED_LIVENESS_CHECK", needLivenessCheck)
        intent.putExtra("CAPTURE_FACE_CAMERA_ID", cameraId.toInt())
        intent.putExtra("CAPTURE_FACE_LINEAR_ZOOM", linearZoom.toFloat())
        intent.putExtra("CAPTURE_FACE_ROTATION_DEGREES", rotationDegrees.toInt())
        context.startActivity(intent)
    })
}

// UniNativeViewElement 及其 Android View 绑定 API 仅存在于 uni-app x。
// 传统 uni-app 会编译同一个 UTS API 入口，因此必须排除标准模式组件桥接代码。
// #ifdef UNI-APP-X

/**
 * 标准模式组件对 CaptureFaceNativeView 的实例封装。
 */
export class CaptureFaceViewContext {
    private element: UniNativeViewElement
    private nativeView: CaptureFaceNativeView

    constructor(element: UniNativeViewElement) {
        this.element = element
        this.nativeView = new CaptureFaceNativeView(element.getAndroidActivity()!)
        this.element.bindAndroidView(this.nativeView)
    }

    setResultCallback(callback: (result: CaptureFaceResult) => void): void {
        this.nativeView.setResultCallback((
            croppedBase64: string,
            silentScore: number,
            originBase64: string
        ) => {
            callback({
                croppedBase64: croppedBase64,
                silentScore: silentScore,
                originBase64: originBase64
            } as CaptureFaceResult)
        })
    }

    setTipsCallback(callback: (tips: CaptureFaceTips) => void): void {
        this.nativeView.setTipsCallback((code: number, message: string) => {
            callback({ code: code, message: message } as CaptureFaceTips)
        })
    }

    setErrorCallback(callback: (error: CaptureFaceError) => void): void {
        this.nativeView.setErrorCallback((code: string, message: string) => {
            callback({ code: code, message: message } as CaptureFaceError)
        })
    }

    setCameraChangedCallback(callback: (result: CaptureFaceCameraChange) => void): void {
        this.nativeView.setCameraChangedCallback((cameraId: number) => {
            callback({ cameraId: cameraId } as CaptureFaceCameraChange)
        })
    }

    setFaceCoverVisible(visible: boolean): void {
        this.nativeView.setFaceCoverVisible(visible)
    }

    setFaceCoverTipsVisible(visible: boolean): void {
        this.nativeView.setFaceCoverTipsVisible(visible)
    }

    start(
        performanceMode: number,
        needLivenessCheck: boolean,
        cameraId: number,
        linearZoom: number,
        rotationDegrees: number
    ): void {
        this.nativeView.start(
            performanceMode.toInt(),
            needLivenessCheck,
            cameraId.toInt(),
            linearZoom.toFloat(),
            rotationDegrees.toInt()
        )
    }

    stop(): void {
        this.nativeView.stop()
    }

    retry(): void {
        this.nativeView.retry()
    }

    switchCamera(cameraId: number): void {
        this.nativeView.switchCamera(cameraId.toInt())
    }

    toggleCamera(): void {
        this.nativeView.toggleCamera()
    }

    canSwitchCamera(): boolean {
        return this.nativeView.canSwitchCamera()
    }

    destroy(): void {
        this.nativeView.release()
    }
}

/** 标准模式组件对 FaceSearchNativeView 的实例封装。 */
export class FaceSearchViewContext {
    private element: UniNativeViewElement
    private nativeView: FaceSearchNativeView

    constructor(element: UniNativeViewElement) {
        this.element = element
        this.nativeView = new FaceSearchNativeView(element.getAndroidActivity()!)
        this.element.bindAndroidView(this.nativeView)
    }

    setResultCallback(callback: (result: FaceSearchResult) => void): void {
        this.nativeView.setResultCallback((
            matchesJson: string,
            liveness: number,
            base64: string
        ) => {
            callback({
                matchesJson: matchesJson,
                liveness: liveness,
                base64: base64
            } as FaceSearchResult)
        })
    }

    setTipsCallback(callback: (tips: FaceSearchTips) => void): void {
        this.nativeView.setTipsCallback((code: number, message: string) => {
            callback({ code: code, message: message } as FaceSearchTips)
        })
    }

    setErrorCallback(callback: (error: FaceSearchError) => void): void {
        this.nativeView.setErrorCallback((code: string, message: string) => {
            callback({ code: code, message: message } as FaceSearchError)
        })
    }

    setCameraChangedCallback(callback: (result: FaceSearchCameraChange) => void): void {
        this.nativeView.setCameraChangedCallback((cameraId: number) => {
            callback({ cameraId: cameraId } as FaceSearchCameraChange)
        })
    }

    setFaceCoverVisible(visible: boolean): void {
        this.nativeView.setFaceCoverVisible(visible)
    }

    start(
        searchThreshold: number,
        searchOneTime: boolean,
        searchTimeOut: number,
        needLivenessCheck: boolean,
        cameraId: number,
        linearZoom: number,
        rotationDegrees: number
    ): void {
        this.nativeView.start(
            searchThreshold.toFloat(),
            searchOneTime,
            searchTimeOut.toInt(),
            needLivenessCheck,
            cameraId.toInt(),
            linearZoom.toFloat(),
            rotationDegrees.toInt()
        )
    }

    stop(): void {
        this.nativeView.stop()
    }

    switchCamera(cameraId: number): void {
        this.nativeView.switchCamera(cameraId.toInt())
    }

    toggleCamera(): void {
        this.nativeView.toggleCamera()
    }

    canSwitchCamera(): boolean {
        return this.nativeView.canSwitchCamera()
    }

    destroy(): void {
        this.nativeView.release()
    }
}

// #endif

/**
 * 启动持续人脸搜索 Activity
 * 
 */
@UTSJS.keepAlive
export function faceSearchByCamera(
    searchThreshold: number,
    searchOneTime: boolean,
    searchTimeOut: number,
    callback: (jsonResult: string) => void
): void {

    FaceResultManager.setCallback((json: string, liveness: number, base64: string) => {
		const finalJson = `{"data":${json},"liveness":${liveness},"base64":"${base64}"}`
        try {
            callback(finalJson);
        } catch(e) {
            console.error("FaceAI Callback Error:", e);
        }
    });

    // 2. 启动 Activity
    UTSAndroid.getUniActivity()!.runOnUiThread(() => {
        const context = UTSAndroid.getUniActivity() as Activity
        FaceSDKConfig.init(context);

        const intent = new Intent(context, FaceSearchActivity().javaClass);
        intent.putExtra("THRESHOLD_KEY", searchThreshold.toFloat()); // 转为 float
        intent.putExtra("SEARCH_ONE_TIME", searchOneTime);
        intent.putExtra("SEARCH_TIME_OUT", searchTimeOut.toInt());    // 转为 int
        context.startActivity(intent);
    });
}



@UTSJS.keepAlive
export function faceSearchByImage(
    base64FaceSearch:string,
    searchThreshold: number,
    callback: (jsonResult: string) => void
): void {

   UTSAndroid.getUniActivity()!.runOnUiThread(() => {
      const context = UTSAndroid.getUniActivity() as Activity;
      FaceSDKConfig.init(context);
      FaceAISDKNative.faceSearchByImageNative(context, base64FaceSearch,searchThreshold.toFloat(), (result: UTSJSONObject) => {
          callback(JSON.stringify(result));
      });
   });

}



// Toast 放到主线程
export function toastMessage(base64Image: string, message: string): void {
	UTSAndroid.getUniActivity()!.runOnUiThread(() => {
		const context = UTSAndroid.getUniActivity() as Activity
		FaceAISDKNative.toastMessage(context, base64Image, message)
	});
}


export function TTSPlayer( message: string): void {
	FaceAISDKNative.TTSPlayer(message)
}

export function switchCamera(cameraID: number): void {
    const context = UTSAndroid.getAppContext() as Application;
    FaceSDKConfig.init(context);
    FaceSDKConfig.setCameraID(context, cameraID.toInt())
}

export function insertFaceSearchFeature(
    faceID: string,
    faceFeature: string,
    tag: string,
    group: string,
    callback: (result: ResultJSON) => void
): void {
    const context = UTSAndroid.getAppContext() as Application
    FaceSDKConfig.init(context);
    
    // 修复：UTS中字符串不可能为null，直接判断是否为空字符串
    if (faceID == "") {
        callback({ code: -1, msg: "参数错误: faceID 不能为空", faceFeature: "", faceBase64: "" } as ResultJSON)
        return 
    }

    if (faceFeature == "" || faceFeature.length != 1024) {
        const currentLen = faceFeature.length;
        callback({ code: -2, msg: `参数错误: faceFeature 长度必须为 1024 (当前: ${currentLen})`, faceFeature: "", faceBase64: "" } as ResultJSON)
        return
    }

    try {
        // 修复：移除冗余的三元运算符 null 校验，防止底层装箱异常
        const safeTag = tag == "" ? "" : tag;
        const safeGroup = group == "" ? "" : group;
        FaceSearchFeatureManger.getInstance(context)
            .insertFaceFeature(faceID, faceFeature, System.currentTimeMillis(), safeTag, safeGroup);
        callback({ code: 1, msg: "success", faceFeature:"", faceBase64: "" } as ResultJSON)

    } catch (e) {
        // 修复：不能写 catch (e: Exception)，UTS 语法不允许为 catch 指定类型
        callback({ code: -3, msg: "Native 执行异常", faceFeature: "", faceBase64: "" } as ResultJSON)
    }
}

export function insertManyFeatures(
    jsonFaceFeatures: string,
    callback: (result: ResultJSON) => void
): void {
    const context = UTSAndroid.getAppContext() as Application
    FaceSDKConfig.init(context);
    let faceCount = FaceSearchFeatureManger.getInstance(context)
        .insertFeatures(jsonFaceFeatures)
    callback({ code: faceCount, msg: "code值为有效同步数据量", faceFeature: "", faceBase64: "-" } as ResultJSON)
}

export function deleteFaceSearchFeature(
    faceID: string, 
    callback: (result: ResultJSON) => void
): void {
    const context = UTSAndroid.getAppContext() as Application
    FaceSDKConfig.init(context);
    FaceSearchFeatureManger.getInstance(context).deleteFaceFaceFeature(faceID);
    callback({ code: 1, msg: "delete success", faceFeature: "", faceBase64: "" } as ResultJSON)
}

export function queryFaceSearchFeature(
    faceID: string, 
    callback: (jsonResult: string) => void
): void {
    const context = UTSAndroid.getAppContext() as Application
    FaceSDKConfig.init(context);
    try {
        const manager = FaceSearchFeatureManger.getInstance(context);
        let nativeResult: any | null = null;
        if (faceID == "") {
            nativeResult = manager.queryAllFaceFaceFeature();
        } else {
            nativeResult = manager.queryFaceFeatureByID(faceID);
        }

        let jsonString = "[]";
        if (nativeResult != null) {
            jsonString = new Gson().toJson(nativeResult);
        }
        callback(jsonString);
    } catch (e) {
        callback("[]");
    }
}

/**
 * Base64人脸图录入人脸
 * 建议640*480 人脸图需要遵守规范：https://i.postimg.cc/RCwNy0kV/add-Face.jpg
 */
export function addFaceSearchFeatureByImage(
    faceID: string,
	base64FaceImage:string,
    callback: (result: ResultJSON) => void
): void {
	const context = UTSAndroid.getUniActivity() as Activity;
    FaceSDKConfig.init(context);
	FaceAISDKNative.getFaceFeatureByImageNative(context, faceID, base64FaceImage, (result: UTSJSONObject) => {
		
        callback({
		    code: (result.getNumber("code") ?? -1) as number,
		    msg: result.getString("msg") ?? "",
			faceFeature: result.getString("faceFeature") ?? "",
            faceBase64: ""
		} as ResultJSON);
	});
}

/**
 * 通过SDK相机录入人脸，推荐
 */
export function addFaceSearchFeatureByCamera(
    faceID: string,
    addFacePerformanceMode: number,
    needShowConfirmDialog: boolean,
    callback: (result: ResultJSON) => void
): void {
    UTSAndroid.getUniActivity()!.runOnUiThread(() => {
        const context = UTSAndroid.getUniActivity() as Activity
        FaceSDKConfig.init(context);
        const intent = new Intent(context, AddFaceFeatureActivity().javaClass)
        intent.putExtra("ADD_FACE_IMAGE_TYPE_KEY", "FACE_SEARCH");
        intent.putExtra("ADD_FACE_PERFORMANCE_MODE", addFacePerformanceMode);
      
        intent.putExtra("USER_FACE_ID_KEY", faceID);
        intent.putExtra("NEED_CONFIRM_ADD_FACE", needShowConfirmDialog);

        context.startActivityForResult(intent, 10086)
    });
    
    UTSAndroid.onAppActivityResult((requestCode: Int, resultCode: Int, intentAct?: Intent) => {
        if (requestCode == 10086) {
            if (intentAct != null) {
                const codeNow = intentAct.getIntExtra("code", 0)
                const rawMsg = intentAct.getStringExtra("msg")
                const msgNow = (rawMsg == null) ? "" : rawMsg
                
                let faceBase64 = ""
				let faceFeature = ""
                if (0 != codeNow) {
                    faceBase64 = BitmapUtils.bitmapToBase64(FaceSDKConfig.CACHE_SEARCH_FACE_DIR + faceID)
					faceFeature = intentAct.getStringExtra("faceFeature") ?? ""
                }
                
                callback({ code: codeNow, msg: msgNow, faceFeature: faceFeature, faceBase64: faceBase64 } as ResultJSON)
            } else {
                callback({ code: -1, msg: "添加失败", faceFeature: "", faceBase64: "" } as ResultJSON)
            }
        }
    });
}
