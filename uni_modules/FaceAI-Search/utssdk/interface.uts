/**
 * 返回给业务方 
 */
export type ResultJSON = {
  code: number,       //code 含义参考Readme 
  msg: string,
  faceFeature:string //人脸特征值，从人脸图提取出来的
  faceBase64:string  //人脸base64 编码，可用于辅助日志等
}

/**
 * 持续人脸抓拍结果。
 * croppedBase64 为 SDK 检测、矫正并裁剪后的 224x224 人脸图；
 * originBase64 为本次检测使用的相机原图。
 */
export type CaptureFaceResult = {
  croppedBase64: string,
  silentScore: number,
  originBase64: string
}

export type CaptureFaceTips = {
  code: number,
  message: string
}

export type CaptureFaceError = {
  code: string,
  message: string
}

export type CaptureFaceCameraChange = {
  cameraId: number
}

/** 可嵌入相机搜索组件的单次回调结果。 */
export type FaceSearchResult = {
  matchesJson: string,
  liveness: number,
  base64: string
}

export type FaceSearchTips = {
  code: number,
  message: string
}

export type FaceSearchError = {
  code: string,
  message: string
}

export type FaceSearchCameraChange = {
  cameraId: number
}

/**
 * 打开全屏相机并持续返回符合要求的人脸。
 * @param performanceMode -1 无限制、0 简单、1 快速、2 精确
 * @param needLivenessCheck 是否计算静默活体分数
 * @param cameraId 0 前置、1 后置；不存在时自动降级到可用摄像头
 * @param linearZoom 线性变焦，范围 0~1；不建议传入过大值，默认推荐 0.01
 * @param rotationDegrees 画面旋转角度，-1 跟随当前显示方向，或固定为 0/90/180/270
 */
export type CaptureFaceByCamera = (
  performanceMode: number,
  needLivenessCheck: boolean,
  cameraId: number,
  linearZoom: number,
  rotationDegrees: number,
  callback: (result: CaptureFaceResult) => void,
  errorCallback: (error: CaptureFaceError) => void
) => void

/**
 * 开启持续人脸搜索 (Activity 常驻)
 * @param searchThreshold 人脸搜索阈值 (只有人脸库中匹配到的人脸相似度大于此才有结果返回)
 * @param searchOneTime 是否仅搜索一次 (搜索页持续搜索接收结果 还是仅仅搜索一次返回一次结果)
 * @param searchTimeOut 搜索超时时间，单位毫秒，范围 3000~6000；仅 searchOneTime=true 时用于无匹配结果后自动关闭页面
 * @param callback 接收搜索结果 JSON 字符串的回调
 */
export type faceSearchByCamera = (
    searchThreshold: number,
    searchOneTime: boolean,
	searchTimeOut:number,
    callback: (jsonResult: string) => void
) => void



/**
 * 开启持续人脸搜索 (Activity 常驻)
 * @param searchThreshold 人脸搜索阈值 (只有人脸库中匹配到的人脸相似度大于此才有结果返回)
 * @param searchOneTime 是否仅搜索一次 (搜索页持续搜索接收结果 还是仅仅搜索一次返回一次结果)
 * @param callback 接收搜索结果 JSON 字符串的回调
 */
export type faceSearchByImage= (
    base64FaceSearch: string,
    searchThreshold: number,
    callback: (jsonResult: string) => void
) => void



/**
 * 「1:N人脸搜索」录入人脸特征值
 * 
 * @param faceID 用户ID
 * @param callback 结果回调
 */
export type AddFaceSearchFeatureByCamera = (
    faceID:string,
	addFacePerformanceMode:number,
	needShowConfirmDialog:boolean,
	callback : (result : ResultJSON) => void) => void
	
/**
 * 「1:N人脸搜索」录入人脸特征值
 * 
 * @param faceID 用户ID
 * @param callback 结果回调
 */
export type AddFaceSearchFeatureByImage = (
    faceID:string,
	base64FaceImage:string,
	callback : (result : ResultJSON) => void) => void
		
	
/**
 * 「1:N人脸搜索」删除一张人脸照片
 * 
 * @param faceID 用户ID
 * @param callback 结果回调
 */
export type DeleteFaceSearchFeature = (
    faceID:string,
	callback : (result : ResultJSON) => void) => void



/**
 * 「1:N人脸搜索」查询人脸特征
 * 
 * @param faceID 用户ID  不传则查询所有数据
 * @param callback 结果回调
 */
export type QueryFaceSearchFeature = (
    faceID:string, 
	callback : (result : string) => void) => void


/**
 * 「1:N人脸搜索」录入一张人脸照片
 * 
 * @param faceID 用户ID
 * @param faceFeature 1024长度的提取的人脸特征值
 * @param tag   标签
 * @param group 分组
 * @param callback 结果回调
 */
export type InsertFaceSearchFeature = (
	faceID : string,
	faceFeature : string, 
	tag : string, 
	group : string,
	callback : (result : ResultJSON) => void) => void
	
	
/**
 * 「1:N人脸搜索」录入一张人脸照片
 * 
 * @param jsonFaceFeatures json 格式数组
 * @param callback 结果回调
 */
export type InsertManyFeatures = (
	jsonFaceFeatures : string,
	callback : (result : ResultJSON) => void) => void
	
export type ToastMessage = (base64Image : string,message : string) => void	

export type TTSPlayer = (message : string) => void	

export type SwitchCameta = (cameraID : number) => void	
